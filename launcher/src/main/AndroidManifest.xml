<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Tema"
        android:usesCleartextTraffic="false">

        <!-- Tela inicial da box -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".EntrarActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".LojaActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".AppsActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".AtualizandoActivity" android:screenOrientation="landscape" android:exported="false"
            android:launchMode="singleTask" android:excludeFromRecents="true" />

        <!-- Deixa a launcher virar a "dona" da box (configuração única pelo ADB) -->
        <receiver
            android:name=".Admin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Liga ao iniciar a box e a cada 15 minutos conversa com o painel -->
        <receiver android:name=".Despertador" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Recebe o resultado das instalações silenciosas -->
        <receiver android:name=".ResultadoInstalacao" android:exported="false" />

        <service android:name=".SincronizarService" android:exported="false" />

        <!-- Entrega o APK baixado ao instalador do Android (modo simples) -->
        <provider
            android:name=".ApkProvider"
            android:authorities="cfd.zarktvqx.launcher.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
